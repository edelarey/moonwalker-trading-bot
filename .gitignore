# Environment variables — never commit
.env
.env.local
.env.*.local
backend/.env
frontend/.env

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Build output
backend/dist/
frontend/dist/

# Runtime data (json storage) — includes encrypted API keys
backend/data/*.json
backend/data/secrets.json
!backend/data/*.json.example
!backend/data/config.json.example
!backend/data/trades.json.example

# Logs
*.log
backend/logs/

# OS
.DS_Store
Thumbs.db
