# Optional fallback only. Prefer saving keys in the Settings UI.
# UI keys are encrypted into backend/data/secrets.json (gitignored).
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# Server
PORT=3001
NODE_ENV=development

# Storage mode: 'json' or 'postgres'
STORAGE_MODE=json

# PostgreSQL (only if STORAGE_MODE=postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/breakbounce

# Encryption key for API key storage
ENCRYPTION_KEY=change_this_to_a_random_32_char_string

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
