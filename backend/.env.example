# Bybit API (use testnet for dev)
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here
BYBIT_TESTNET=true

# Server
PORT=3001
NODE_ENV=development

# Storage mode: 'json' or 'postgres'
STORAGE_MODE=json

# PostgreSQL (only if STORAGE_MODE=postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/breakbounce

# Encryption key for API key storage
ENCRYPTION_KEY=change_this_to_a_random_32_char_string

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
